{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "http://localhost:8080",
        "WS_URL": "ws://localhost:8080",
        "SOLANA_NETWORK": "devnet",
        "SOLANA_RPC_URL": "https://api.devnet.solana.com"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "API_URL": "https://beast-arena-server-staging.fly.dev",
        "WS_URL": "wss://beast-arena-server-staging.fly.dev",
        "SOLANA_NETWORK": "devnet",
        "SOLANA_RPC_URL": "https://api.devnet.solana.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "API_URL": "https://beast-arena-server.fly.dev",
        "WS_URL": "wss://beast-arena-server.fly.dev",
        "SOLANA_NETWORK": "mainnet-beta",
        "SOLANA_RPC_URL": "https://api.mainnet-beta.solana.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "production"
      },
      "ios": {
        "appleId": "YOUR_APPLE_ID",
        "ascAppId": "YOUR_ASC_APP_ID",
        "appleTeamId": "YOUR_TEAM_ID"
      }
    }
  }
}
